    <worksheet name='Foglio 3.3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Firma operativa: distribuzione delle armi primarie per gruppo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GTD Star' name='federated.1uwnzur0evf63z12rs1zj14huhen' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N gruppi Heatmap' datatype='integer' name='[Parametro 0021691825111041]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='20' min='5' />
            </column>
            <column caption='Metrica gruppi' datatype='string' name='[Parametro 1857326402789382]' param-domain-type='list' role='measure' type='nominal' value='&quot;Attentati&quot;'>
              <calculation class='tableau' formula='&quot;Attentati&quot;' />
            </column>
            <column caption='Provenienza decessi' datatype='string' name='[Parametro 2015518399840265]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tutti&quot;'>
              <calculation class='tableau' formula='&quot;Tutti&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwnzur0evf63z12rs1zj14huhen'>
            <column caption='Punteggio Metrica Gruppo' datatype='integer' name='[Calculation_0021691830317059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326402789382]&#10;WHEN &quot;Attentati&quot; THEN 1&#10;WHEN &quot;Decessi&quot; THEN ZN([nkill])&#10;WHEN &quot;Vittime non attentatori&quot; THEN ZN([nkill_victims])&#10;END' />
            </column>
            <column caption='Includi provenienza decessi' datatype='boolean' name='[Calculation_2015518400049162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 2015518399840265] = &quot;Solo osservati&quot; THEN&#10;    [nkill_source] = &quot;Reported&quot;&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Quota arma primaria nel gruppo' datatype='real' default-format='p0.00%' name='[Calculation_3000406183403520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([eventid])&#10;/&#10;MAX({ FIXED [gname] : COUNTD([eventid]) })' />
            </column>
            <column caption='Etichetta firma tattica' datatype='real' default-format='p0.00%' name='[Calculation_3000406183489537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3000406183403520] &gt;= 0.01 THEN&#10;    [Calculation_3000406183403520]&#10;END' />
            </column>
            <column caption='Valore complessivo gruppo' datatype='integer' name='[Calculation_3000406192873474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326402789382]&#10;WHEN &quot;Attentati&quot; THEN &#10;    { FIXED [gname] : COUNTD([eventid]) }&#10;WHEN &quot;Decessi&quot; THEN &#10;    { FIXED [gname] : SUM([nkill]) }&#10;WHEN &quot;Vittime non attentatori&quot; THEN &#10;    { FIXED [gname] : SUM([nkill_victims]) }&#10;END' />
            </column>
            <column caption='Decade' datatype='string' name='[decade]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Eventid' datatype='integer' name='[eventid]' role='dimension' type='ordinal' />
            <column caption='Terrorist Group' datatype='string' name='[gname]' role='dimension' type='nominal' />
            <column caption='Is Unknown Perpetrator' datatype='boolean' name='[is_unknown_perpetrator]' role='dimension' type='nominal' />
            <column caption='Nkill' datatype='integer' name='[nkill]' role='measure' type='quantitative' />
            <column caption='Nkill Source' datatype='string' name='[nkill_source]' role='dimension' type='nominal' />
            <column caption='Nkill Victims' datatype='integer' name='[nkill_victims]' role='measure' type='quantitative' />
