    <worksheet name='Foglio 2.3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Tipi di attacco: frequenza e letalità</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GTD Star' name='federated.1uwnzur0evf63z12rs1zj14huhen' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Livello Dettaglio' datatype='string' name='[Parametro 1857326391898114]' param-domain-type='list' role='measure' type='nominal' value='&quot;Macro&quot;'>
              <calculation class='tableau' formula='&quot;Macro&quot;' />
            </column>
            <column caption='Provenienza decessi' datatype='string' name='[Parametro 2015518399840265]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tutti&quot;'>
              <calculation class='tableau' formula='&quot;Tutti&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwnzur0evf63z12rs1zj14huhen'>
            <column caption='Dimensione attiva - Attack' datatype='string' name='[Calculation_1857326392451077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326391898114]&#10;WHEN &quot;Macro&quot; THEN [attack_macro]&#10;WHEN &quot;Dettaglio&quot; THEN [attack_name]&#10;WHEN &quot;Sottotipo&quot; THEN [attack_name]&#10;END' />
            </column>
            <column caption='Attentati' datatype='integer' name='[Calculation_2015518387396608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([eventid])' />
            </column>
            <column caption='Decessi complessivi' datatype='integer' name='[Calculation_2015518387499009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nkill])' />
            </column>
            <column caption='Includi provenienza decessi' datatype='boolean' name='[Calculation_2015518400049162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 2015518399840265] = &quot;Solo osservati&quot; THEN&#10;    [nkill_source] = &quot;Reported&quot;&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Quadrante scatter' datatype='string' name='[Calculation_2015518553759770]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2015518571253793] &gt;= WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &gt;= WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Alta frequenza · alta gravità&quot;&#10;ELSEIF [Calculation_2015518571253793] &gt;= WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &lt; WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Alta frequenza · minore gravità&quot;&#10;ELSEIF [Calculation_2015518571253793] &lt; WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &gt;= WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Bassa frequenza · alta gravità&quot;&#10;ELSE &quot;Bassa frequenza · minore gravità&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Letalità categoria' datatype='real' name='[Calculation_2015518570844192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2015518387396608] = 0 THEN NULL&#10;ELSE SUM([nkill]) / COUNTD([eventid])&#10;END' />
            </column>
            <column caption='Frequenza categoria' datatype='integer' name='[Calculation_2015518571253793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([eventid])' />
            </column>
            <column caption='Attack Macro' datatype='string' name='[attack_macro]' role='dimension' type='nominal' />
            <column caption='Attack Name' datatype='string' name='[attack_name]' role='dimension' type='nominal' />
            <column caption='Decade' datatype='string' name='[decade]' role='dimension' type='nominal' />
