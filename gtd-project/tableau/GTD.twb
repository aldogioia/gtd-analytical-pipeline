            <column caption='Nkill' datatype='integer' name='[nkill]' role='measure' type='quantitative' />
            <column caption='Nkill Source' datatype='string' name='[nkill_source]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1857326392451077]' derivation='None' name='[none:Calculation_1857326392451077:nk]' pivot='key' type='nominal' />
