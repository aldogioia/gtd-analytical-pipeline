      <aliases enabled='yes' />
      <column datatype='string' name='[Attack Name (gruppo)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[attack_name]' new-bin='true'>
          <bin default-name='false' value='&quot;Other&quot;'>
            <value>&quot;Facility/Infrastructure Attack&quot;</value>
            <value>&quot;Hijacking&quot;</value>
            <value>&quot;Hostage Taking (Barricade Incident)&quot;</value>
            <value>&quot;Hostage Taking (Kidnapping)&quot;</value>
            <value>&quot;Unarmed Assault&quot;</value>
            <value>&quot;Unknown&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Punteggio Metrica Gruppo' datatype='integer' name='[Calculation_0021691830317059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326402789382]&#10;WHEN &quot;Attentati&quot; THEN 1&#10;WHEN &quot;Decessi&quot; THEN ZN([nkill])&#10;WHEN &quot;Vittime non attentatori&quot; THEN ZN([nkill_victims])&#10;END' />
      </column>
      <column caption='Tasso Danno Materiale' datatype='real' default-format='p0.00%' name='[Calculation_1513659723546624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF([propvalue] &gt; 0, [eventid], NULL)) / COUNTD([eventid])' />
      </column>
      <column caption='Quota transnazionale' datatype='real' default-format='p0.00%' name='[Calculation_1522728929198086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [is_transnational] = 1 THEN [eventid] END&#10;)&#10;/&#10;COUNTD(&#10;    IF NOT ISNULL([is_transnational]) THEN [eventid] END&#10;)' />
      </column>
      <column caption='Tasso di successo' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1522728930000903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_success]) / COUNTD([eventid])' />
      </column>
      <column caption='Quota vittime stimate' datatype='real' name='[Calculation_1522728932720648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([nkill_source] = &apos;Imputed&apos;, [nkill], 0)) / SUM([nkill])' />
      </column>
      <column caption='Dimensione attiva - Weapon' datatype='string' name='[Calculation_1857326392090627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326391898114]&#10;WHEN &quot;Macro&quot; THEN [weapon_macro]&#10;WHEN &quot;Dettaglio&quot; THEN [weapon_name]&#10;WHEN &quot;Sottotipo&quot; THEN [weapon_subtype]&#10;END' />
      </column>
      <column caption='Dimensione attiva - Target' datatype='string' name='[Calculation_1857326392238084]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326391898114]&#10;WHEN &quot;Macro&quot; THEN [target_macro]&#10;WHEN &quot;Dettaglio&quot; THEN [target_name]&#10;WHEN &quot;Sottotipo&quot; THEN [target_subtype]&#10;END' />
      </column>
      <column caption='Dimensione attiva - Attack' datatype='string' name='[Calculation_1857326392451077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326391898114]&#10;WHEN &quot;Macro&quot; THEN [attack_macro]&#10;WHEN &quot;Dettaglio&quot; THEN [attack_name]&#10;WHEN &quot;Sottotipo&quot; THEN [attack_name]&#10;END' />
      </column>
      <column caption='Valore gruppo' datatype='integer' name='[Calculation_1857326403362825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326402789382]&#10;WHEN &quot;Attentati&quot; THEN COUNTD([eventid])&#10;WHEN &quot;Decessi&quot; THEN SUM([nkill])&#10;WHEN &quot;Vittime non attentatori&quot; THEN SUM([nkill_victims])&#10;END' />
      </column>
      <column caption='Percentuale cumulativa gruppo' datatype='real' name='[Calculation_1857326403473418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_1857326403362825]) &#10;/ &#10;WINDOW_SUM([Calculation_1857326403362825])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank gruppo' datatype='integer' name='[Calculation_1857326403555339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1857326403362825], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtro Top N gruppi' datatype='boolean' name='[Calculation_1857326403624972]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1857326403555339] &lt;= [Parameters].[Parametro 1857326402936839]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Attentati' datatype='integer' name='[Calculation_2015518387396608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([eventid])' />
      </column>
      <column caption='Decessi complessivi' datatype='integer' name='[Calculation_2015518387499009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nkill])' />
      </column>
      <column caption='Vittime (non attentatori)' datatype='integer' name='[Calculation_2015518387593218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nkill_victims])' />
      </column>
      <column caption='Feriti noti' datatype='integer' name='[Calculation_2015518388834308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nwound])' />
      </column>
      <column caption='Tipo di terrorismo' datatype='string' name='[Calculation_2015518396194821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tipo di terrorismo&#10;IF [is_transnational] = 1 THEN &quot;Transnazionale&quot;&#10;ELSEIF [is_transnational] = 0 THEN &quot;Domestico&quot;&#10;ELSE &quot;Non determinabile&quot;&#10;END' />
      </column>
      <column caption='Eventi con transnazionalità determinabile' datatype='integer' name='[Calculation_2015518396899334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF NOT ISNULL([is_transnational]) THEN [eventid] END&#10;)' />
      </column>
      <column caption='Includi provenienza decessi' datatype='boolean' name='[Calculation_2015518400049162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parametro 2015518399840265] = &quot;Solo osservati&quot; THEN&#10;    [nkill_source] = &quot;Reported&quot;&#10;ELSE&#10;    TRUE&#10;END' />
      </column>
      <column caption='Quota decessi osservati' datatype='real' name='[Calculation_2015518400249867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [nkill_source] = &quot;Reported&quot; THEN [eventid] END&#10;)&#10;/&#10;COUNTD([eventid])' />
      </column>
      <column caption='Periodo visualizzato' datatype='datetime' name='[Calculation_2015518400999436]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 2015518397050887]&#10;WHEN &quot;Decennio&quot; THEN&#10;    MAKEDATE(&#10;        INT(DATEPART(&apos;year&apos;, [full_date]) / 10) * 10,&#10;        1,&#10;        1&#10;    )&#10;WHEN &quot;Anno&quot; THEN DATETRUNC(&apos;year&apos;, [full_date])&#10;WHEN &quot;Trimestre&quot; THEN DATETRUNC(&apos;quarter&apos;, [full_date])&#10;WHEN &quot;Mese&quot; THEN DATETRUNC(&apos;month&apos;, [full_date])&#10;END' />
      </column>
      <column caption='Mostra Top N' datatype='boolean' name='[Calculation_2015518408761358]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2015518408904719] &lt;= [Parameters].[Parametro 2015518408593421]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank paese' datatype='integer' name='[Calculation_2015518408904719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_2015518387396608], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Mostra classifica' datatype='boolean' name='[Calculation_2015518418227216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parametro 2015518399422472] = &quot;Classifica&quot;' />
      </column>
      <column caption='Mostra mappa' datatype='boolean' name='[Calculation_2015518418288657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parametro 2015518399422472] = &quot;Mappa&quot;' />
      </column>
      <column caption='Mostra scatter attacco' datatype='boolean' name='[Calculation_2015518429093909]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parametro 2015518427537426]=&quot;Attacco&quot;' />
      </column>
      <column caption='Mostra scatter bersaglio' datatype='boolean' name='[Calculation_2015518429216790]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parametro 2015518427537426]=&quot;Bersaglio&quot;' />
      </column>
      <column caption='Mostra scatter arma' datatype='boolean' name='[Calculation_2015518429298711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parametro 2015518427537426]=&quot;Arma&quot;' />
      </column>
      <column caption='Quadrante scatter' datatype='string' name='[Calculation_2015518553759770]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2015518571253793] &gt;= WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &gt;= WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Alta frequenza · alta gravità&quot;&#10;ELSEIF [Calculation_2015518571253793] &gt;= WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &lt; WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Alta frequenza · minore gravità&quot;&#10;ELSEIF [Calculation_2015518571253793] &lt; WINDOW_MEDIAN([Calculation_2015518571253793])&#10;AND [Calculation_2015518570844192] &gt;= WINDOW_MEDIAN([Calculation_2015518570844192])&#10;THEN &quot;Bassa frequenza · alta gravità&quot;&#10;ELSE &quot;Bassa frequenza · minore gravità&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Eventi regione' datatype='integer' name='[Calculation_2015518566985757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region_name] : COUNTD([eventid]) }' />
      </column>
      <column caption='Quota bersaglio nella regione' datatype='real' default-format='p0.00%' name='[Calculation_2015518567497758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([eventid]) / MAX([Calculation_2015518566985757])' />
      </column>
      <column caption='Etichetta heatmap' datatype='real' default-format='p0.00%' name='[Calculation_2015518568644639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2015518567497758] &gt;= 0.10 THEN&#10;    [Calculation_2015518567497758]&#10;END' />
      </column>
      <column caption='Letalità categoria' datatype='real' name='[Calculation_2015518570844192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2015518387396608] = 0 THEN NULL&#10;ELSE SUM([nkill]) / COUNTD([eventid])&#10;END' />
      </column>
      <column caption='Frequenza categoria' datatype='integer' name='[Calculation_2015518571253793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([eventid])' />
      </column>
      <column caption='Media mobile suicidi - 3 anni' datatype='real' name='[Calculation_2015518573928482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_4321186351849473], -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Anno' datatype='datetime' name='[Calculation_2015518575423523]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;, [full_date])' />
      </column>
      <column caption='Totale eventi anno' datatype='integer' name='[Calculation_2015518575476772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_2015518575423523] : COUNTD([eventid]) }' />
      </column>
      <column caption='Quota mix' datatype='real' default-format='p0.00%' name='[Calculation_2015518575570981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([eventid]) / MAX([Calculation_2015518575476772])' />
      </column>
      <column caption='Quota arma primaria nel gruppo' datatype='real' default-format='p0.00%' name='[Calculation_3000406183403520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([eventid])&#10;/&#10;MAX({ FIXED [gname] : COUNTD([eventid]) })' />
      </column>
      <column caption='Etichetta firma tattica' datatype='real' default-format='p0.00%' name='[Calculation_3000406183489537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3000406183403520] &gt;= 0.01 THEN&#10;    [Calculation_3000406183403520]&#10;END' />
      </column>
      <column caption='Valore complessivo gruppo' datatype='integer' name='[Calculation_3000406192873474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326402789382]&#10;WHEN &quot;Attentati&quot; THEN &#10;    { FIXED [gname] : COUNTD([eventid]) }&#10;WHEN &quot;Decessi&quot; THEN &#10;    { FIXED [gname] : SUM([nkill]) }&#10;WHEN &quot;Vittime non attentatori&quot; THEN &#10;    { FIXED [gname] : SUM([nkill_victims]) }&#10;END' />
      </column>
      <column caption='Rank gruppo Heatmap' datatype='integer' name='[Calculation_3000406193025027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(MIN([Calculation_3000406192873474]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtro Top N Heatmap' datatype='boolean' name='[Calculation_3000406193209348]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3000406193025027] &lt;= [Parameters].[Parametro 0021691825111041]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MAE dichiarato' datatype='real' default-format='p0.0%' name='[Calculation_3000406205632517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.147' />
      </column>
      <column caption='Bias totale dichiarato' datatype='real' default-format='p0.0%' name='[Calculation_3000406205779974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-0.0149' />
      </column>
      <column caption='Zero recall dichiarata' datatype='real' default-format='p0.0%' name='[Calculation_3000406206050311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.878' />
      </column>
      <column caption='Colore KPI Bias' datatype='string' name='[Calculation_3000406206214152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_3000406205779974]) &lt;= 0.15 THEN &quot;Valido&quot; ELSE &quot;Critico&quot; END' />
      </column>
      <column caption='Letalità - tutti i dati' datatype='real' name='[Calculation_3000406206316553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nkill]) / COUNTD([eventid])' />
      </column>
      <column caption='Delta robustezza assoluto' datatype='real' name='[Calculation_3000406206496778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3000406206316553] - [Calculation_4321186352193541]' />
      </column>
      <column caption='Delta robustezza percentuale' datatype='real' name='[Calculation_3000406206570507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4321186352193541] = 0 THEN NULL&#10;ELSE ([Calculation_3000406206316553] / [Calculation_4321186352193541]) - 1&#10;END' />
      </column>
      <column caption='Etichetta Delta Dumbbell' datatype='real' default-format='p0.00%' name='[Calculation_3000406206636044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS([Calculation_3000406206496778]) &gt; 0.05 THEN&#10;    [Calculation_3000406206496778]&#10;END' />
      </column>
      <column caption='Conteggio Eventi Osservati' datatype='integer' name='[Calculation_3000406206746637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nkill_source] = &quot;Reported&quot; THEN [eventid] END)' />
      </column>
      <column caption='Conteggio Eventi Imputati' datatype='integer' name='[Calculation_3000406206877710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nkill_source] = &quot;Imputed&quot; THEN [eventid] END)' />
      </column>
      <column caption='Quota morti osservati' datatype='real' name='[Calculation_3000406206963727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nkill_source] = &quot;Reported&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Quota morti imputati' datatype='real' name='[Calculation_3000406207012880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nkill_source] = &quot;Imputed&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Quota morti mancanti' datatype='real' name='[Calculation_3000406207094801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([Calculation_3000406206963727] + [Calculation_3000406207012880])' />
      </column>
      <column caption='Quota feriti riportati' datatype='real' name='[Calculation_3000406207168530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nwound_source] = &quot;Reported&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Quota feriti mancanti' datatype='real' name='[Calculation_3000406207229971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [nwound_source] = &quot;Not Reported&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Quota data esatta' datatype='real' name='[Calculation_3000406207287316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [date_accuracy] = &quot;Exact&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Quota data approssimata' datatype='real' name='[Calculation_3000406207340565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [date_accuracy] = &quot;Approximate&quot; THEN [eventid] END) / COUNTD([eventid])' />
      </column>
      <column caption='Colore KPI MAE' datatype='string' name='[Calculation_3000406207606806]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3000406205632517] &gt;= 0.10 THEN &quot;Valido&quot; ELSE &quot;Critico&quot; END' />
      </column>
      <column caption='Letalità media per attentato' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4321186351734784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2015518387396608] = 0 THEN NULL&#10;ELSE [Calculation_2015518387499009] / [Calculation_2015518387396608]&#10;END' />
      </column>
      <column caption='Quota suicidi' datatype='real' default-format='p0.00%' name='[Calculation_4321186351849473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [is_suicide] = 1 THEN [eventid] END&#10;)&#10;/&#10;COUNTD([eventid])' />
      </column>
      <column caption='Letalità - solo osservati' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4321186352193541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nkill_source] = &quot;Reported&quot; THEN [nkill] END)&#10;/&#10;COUNTD(IF [nkill_source] = &quot;Reported&quot; THEN [eventid] END)' />
      </column>
      <column caption='Metrica selezionata' datatype='real' name='[Calculation_4321186696982536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parametro 4321186696359943]&#10;  WHEN &apos;Attentati&apos; THEN COUNTD([eventid])&#10;  WHEN &apos;Vittime&apos;   THEN SUM([nkill])&#10;  ELSE [Calculation_4321186351734784]&#10;END' />
      </column>
      <column caption='Quota ignoti' datatype='real' default-format='p0.00%' name='[Calculation_4321186727223306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [is_unknown_perpetrator] = TRUE THEN [eventid] END&#10;) &#10;/ &#10;COUNTD([eventid])' />
      </column>
      <column caption='Scarto' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4321186730876940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4321186351734784]-[Calculation_4321186352193541]) / [Calculation_4321186352193541]' />
      </column>
