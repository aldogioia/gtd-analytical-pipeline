    <worksheet name='Foglio 1.3'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Classifica dei Paesi</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GTD Star' name='federated.1uwnzur0evf63z12rs1zj14huhen' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularità tempo' datatype='string' name='[Parametro 2015518397050887]' param-domain-type='list' role='measure' type='nominal' value='&quot;Anno&quot;'>
              <calculation class='tableau' formula='&quot;Anno&quot;' />
            </column>
            <column caption='Provenienza decessi' datatype='string' name='[Parametro 2015518399840265]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tutti&quot;'>
              <calculation class='tableau' formula='&quot;Tutti&quot;' />
            </column>
            <column caption='Top N' datatype='integer' name='[Parametro 2015518408593421]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='20' min='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwnzur0evf63z12rs1zj14huhen'>
            <column caption='Quota transnazionale' datatype='real' default-format='p0.00%' name='[Calculation_1522728929198086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [is_transnational] = 1 THEN [eventid] END&#10;)&#10;/&#10;COUNTD(&#10;    IF NOT ISNULL([is_transnational]) THEN [eventid] END&#10;)' />
            </column>
            <column caption='Attentati' datatype='integer' name='[Calculation_2015518387396608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([eventid])' />
            </column>
            <column caption='Decessi complessivi' datatype='integer' name='[Calculation_2015518387499009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nkill])' />
            </column>
            <column caption='Includi provenienza decessi' datatype='boolean' name='[Calculation_2015518400049162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 2015518399840265] = &quot;Solo osservati&quot; THEN&#10;    [nkill_source] = &quot;Reported&quot;&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Quota decessi osservati' datatype='real' name='[Calculation_2015518400249867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [nkill_source] = &quot;Reported&quot; THEN [eventid] END&#10;)&#10;/&#10;COUNTD([eventid])' />
            </column>
            <column caption='Periodo visualizzato' datatype='datetime' name='[Calculation_2015518400999436]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parametro 2015518397050887]&#10;WHEN &quot;Decennio&quot; THEN&#10;    MAKEDATE(&#10;        INT(DATEPART(&apos;year&apos;, [full_date]) / 10) * 10,&#10;        1,&#10;        1&#10;    )&#10;WHEN &quot;Anno&quot; THEN DATETRUNC(&apos;year&apos;, [full_date])&#10;WHEN &quot;Trimestre&quot; THEN DATETRUNC(&apos;quarter&apos;, [full_date])&#10;WHEN &quot;Mese&quot; THEN DATETRUNC(&apos;month&apos;, [full_date])&#10;END' />
            </column>
            <column caption='Mostra Top N' datatype='boolean' name='[Calculation_2015518408761358]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2015518408904719] &lt;= [Parameters].[Parametro 2015518408593421]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rank paese' datatype='integer' name='[Calculation_2015518408904719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE([Calculation_2015518387396608], &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Letalità media per attentato' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4321186351734784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2015518387396608] = 0 THEN NULL&#10;ELSE [Calculation_2015518387499009] / [Calculation_2015518387396608]&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Decade' datatype='string' name='[decade]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Eventid' datatype='integer' name='[eventid]' role='dimension' type='ordinal' />
