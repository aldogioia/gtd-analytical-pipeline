      <layout-options>
        <title>
          <formatted-text>
            <run>Heatmap bersagli</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GTD Star' name='federated.1uwnzur0evf63z12rs1zj14huhen' />
            <datasource caption='Parametri' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Livello Dettaglio' datatype='string' name='[Parametro 1857326391898114]' param-domain-type='list' role='measure' type='nominal' value='&quot;Macro&quot;'>
              <calculation class='tableau' formula='&quot;Macro&quot;' />
            </column>
            <column caption='Provenienza decessi' datatype='string' name='[Parametro 2015518399840265]' param-domain-type='list' role='measure' type='nominal' value='&quot;Tutti&quot;'>
              <calculation class='tableau' formula='&quot;Tutti&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwnzur0evf63z12rs1zj14huhen'>
            <column caption='Dimensione attiva - Attack' datatype='string' name='[Calculation_1857326392451077]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parametro 1857326391898114]&#10;WHEN &quot;Macro&quot; THEN [attack_macro]&#10;WHEN &quot;Dettaglio&quot; THEN [attack_name]&#10;WHEN &quot;Sottotipo&quot; THEN [attack_name]&#10;END' />
            </column>
            <column caption='Includi provenienza decessi' datatype='boolean' name='[Calculation_2015518400049162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parametro 2015518399840265] = &quot;Solo osservati&quot; THEN&#10;    [nkill_source] = &quot;Reported&quot;&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Eventi regione' datatype='integer' name='[Calculation_2015518566985757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region_name] : COUNTD([eventid]) }' />
            </column>
            <column caption='Quota bersaglio nella regione' datatype='real' default-format='p0.00%' name='[Calculation_2015518567497758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([eventid]) / MAX([Calculation_2015518566985757])' />
            </column>
            <column caption='Etichetta heatmap' datatype='real' default-format='p0.00%' name='[Calculation_2015518568644639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2015518567497758] &gt;= 0.10 THEN&#10;    [Calculation_2015518567497758]&#10;END' />
            </column>
            <column caption='Attack Macro' datatype='string' name='[attack_macro]' role='dimension' type='nominal' />
            <column caption='Attack Name' datatype='string' name='[attack_name]' role='dimension' type='nominal' />
            <column caption='Decade' datatype='string' name='[decade]' role='dimension' type='nominal' />
